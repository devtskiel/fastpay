# Server environment configuration example

# PostgreSQL connection string for the server database
DATABASE_URL=postgres://appuser:apppassword@localhost:5432/approvals_db

# API key used by the mobile app for x-api-key authorization
APP_SERVER_KEY=change_this_to_a_strong_random_value

# Optional alternate API key name for compatibility
# API_KEY=change_this_to_a_strong_random_value

# JWT secret for signing tokens
JWT_SECRET=change_this_to_a_secure_random_string

# SwiftPay gateway keys
SWIFTPAY_PUBLIC_KEY=your_swiftpay_public_key
SWIFTPAY_SECRET_KEY=your_swiftpay_secret_key

# Optional email delivery config for OTP
RESEND_API_KEY=your_resend_api_key
OTP_SENDER_EMAIL=onboarding@resend.dev

# Optional public URL for callback construction
APP_PUBLIC_URL=https://swiftpay-merchant-gateway.onrender.com
